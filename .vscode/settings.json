{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.jdt.ls.lombokSupport.enabled": true,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/work/**",
    "**/docs/history/**",
    "**/target/**"
  ],
  "files.watcherExclude": {
    "**/work/**": true,
    "**/docs/history/**": true
  },
  "search.exclude": {
    "**/work/**": true,
    "**/docs/history/**": true
  }
}
