<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lab.commerce.mapper.UserMapper">
    <select id="findByUsername" resultType="lab.commerce.entity.LabUser">
        SELECT id, username, password_hash AS passwordHash FROM lab_user WHERE username = #{username}
    </select>
</mapper>
